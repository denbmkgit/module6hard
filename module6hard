class Figure:
    sides_count = 0

    def __init__(self, color, sides):
        self.__sides = sides
        self.__color = color
        self.filled = True

    def get_color(self):
        return list(self.__color)

    def __is_valid_color(self, r, g, b):
        return (0 <= r <= 255 and 0 <= g <= 255 and 0 <= b <= 255 and isinstance(r, int) and isinstance(g, int)
                and isinstance(b, int))

    def set_color(self, r, g, b):
        if self.__is_valid_color(r, g, b) == True:
            self.__color = r, g, b
        else:
            self.__color = self.__color

    def __is_valid_sides(self, *sides):
        return self.sides_count == len(sides)

    def get_sides(self):
        return list(self.__sides)

    def __len__(self):
        return sum(self.sides_count)

    def set_sides(self, *new_sides):
        if self.sides_count == len(new_sides):
            self.__sides = new_sides
        else:
            self.__sides = self.__sides

class Circle(Figure):
    sides_count = 1

    def __init__(self, color, sides):
        super().__init__(color, sides)
        self.__sides = sides
        self.__radius = sides / 2 / 3.1415926535

    def get_square(self):
        return (3.1415926535 * self.__radius)**2

    def __len__(self):
        return self.__sides

